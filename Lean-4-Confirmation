  dsimp [x_star, p]
  have h_sub : 2 - 1 = (1 : ℝ) := by ring
  rw [h_sub, rpow_one]
  have h_phi_nonzero : φ ≠ 0 := by linarith
  have h_one_minus : 1 - 1 / φ = (φ - 1) / φ := by
    field_simp
  rw [h_one_minus]
  have h_phi_identity : φ - 1 = 1 / φ := by
    have h_quad : φ * (φ - 1) = 1 := by
      calc φ * (φ - 1) = φ^2 - φ := by ring
      _ = (φ + 1) - φ := by rw [hφ]
      _ = 1 := by ring
    exact eq_one_div_of_mul_eq_one_right h_quad
  rw [h_phi_identity]
  field_simp

