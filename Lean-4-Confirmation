/-- The autonomous drag velocity function f(x) = x(1 - x) - α x^p -/
noncomputable def f (α : ℝ) (p : ℝ) (x : ℝ) : ℝ :=
  x * (1 - x) - α * (x ^ p)

/-- Theorem 1: Boundary Invariance at Zero (No Negative Escape)
    The velocity vanishes at x = 0, proving x = 0 is an invariant manifold. -/
theorem zero_boundary_invariant (α p : ℝ) (hp : p > 1) :
    f α p 0 = 0 := by
  dsimp [f]
  have h_zero_pow : (0 : ℝ) ^ p = 0 := by
    apply zero_rpow
    linarith
  rw [h_zero_pow]
  ring

/-- Theorem 2: Inward Flow at Carrying Capacity
    At x = 1, the velocity is strictly negative (-α), preventing blow-up past 1. -/
theorem carrying_capacity_inward (α p : ℝ) (hα : α > 0) :
    f α p 1 = -α := by
  dsimp [f]
  have h_one_pow : (1 : ℝ) ^ p = 1 := one_rpow p
  rw [h_one_pow]
  ring

/-- Theorem 3: The Universal Equilibrium Manifold Identity
    Any interior equilibrium x* ∈ (0, 1) satisfies α(x*; p) = (1 - x*) / (x*)^(p - 1). -/
theorem equilibrium_manifold_identity (α p x_star : ℝ) 
    (hx : 0 < x_star ∧ x_star < 1) 
    (hp : p > 1)
    (h_equil : f α p x_star = 0) :
    α = (1 - x_star) / (x_star ^ (p - 1)) := by
  dsimp [f] at h_equil
  have hx_pos : x_star > 0 := hx.1
  have h_split_pow : x_star ^ p = x_star * x_star ^ (p - 1) := by
    have h_re : p = 1 + (p - 1) := by ring
    nth_rw 1 [h_re]
    rw [rpow_add hx_pos]
    rw [rpow_one]
  rw [h_split_pow] at h_equil
  have h_factor : x_star * ((1 - x_star) - α * x_star ^ (p - 1)) = 0 := by
    linear_combination h_equil
  have h_nonzero : x_star ≠ 0 := by linarith
  have h_inner : (1 - x_star) - α * x_star ^ (p - 1) = 0 := by
    cases mul_eq_zero.mp h_factor with
    | inl h1 => contradiction
    | inr h2 => exact h2
  have h_pow_pos : x_star ^ (p - 1) > 0 := by
    apply rpow_pos_of_pos hx_pos
  have h_pow_nonzero : x_star ^ (p - 1) ≠ 0 := by linarith
  exact (eq_div_iff h_pow_nonzero).mpr (by linear_combination h_inner)

/-- Theorem 4: The Golden Ratio Anchor Identity
    For quadratic drag (p = 2), setting x* = φ⁻¹ yields α = φ⁻¹. -/
theorem golden_ratio_drag_anchor (φ : ℝ) (hφ : φ^2 = φ + 1) (hφ_pos : φ > 1) :
    let x_star := 1 / φ
    let p := (2 : ℝ)
    (1 - x_star) / (x_star ^ (p - 1)) = 1 / φ := by
